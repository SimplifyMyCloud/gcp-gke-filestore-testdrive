project_id = "your-gcp-project-id"
region     = "us-west1"

# Cluster 1 Configuration
cluster1_name = "filestore-cluster-1"
cluster1_zone = "us-west1-a"
cluster1_subnet_cidr = "10.0.0.0/24"

# Cluster 2 Configuration
cluster2_name = "filestore-cluster-2"
cluster2_zone = "us-west1-b"
cluster2_subnet_cidr = "10.0.1.0/24"

# Network Configuration
pods_cidr_cluster1     = "10.1.0.0/16"
services_cidr_cluster1 = "10.2.0.0/16"
pods_cidr_cluster2     = "10.3.0.0/16"
services_cidr_cluster2 = "10.4.0.0/16"

# Node Configuration
node_count        = 2
min_node_count    = 1
max_node_count    = 4
machine_type      = "n2-standard-4"
preemptible_nodes = false  # Enterprise testing needs stability

# Enterprise Filestore Configuration
filestore_name        = "enterprise-filestore-shared"
filestore_tier        = "ENTERPRISE"
filestore_capacity_gb = 1024
filestore_share_name  = "shared_data"
filestore_share2_name = "cluster_specific"